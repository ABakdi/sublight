{
  "name": "@sublight/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local inference engine server (Hono on Node 22, Spec 06)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "pnpm typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@sublight/core": "workspace:*",
    "@sublight/protocol": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
